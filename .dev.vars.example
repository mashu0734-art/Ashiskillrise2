# Cloudflare Worker Local Development Variables (.dev.vars)
# Copy this file to .dev.vars for local testing with wrangler dev
# WARNING: Do not commit actual secrets to version control

# JWT Secret for signing session tokens (generate a 32+ character random string)
JWT_SECRET="ashiskillrise_local_dev_secret_key_change_in_production_min_32_chars"

# Optional: Resend or SendGrid API key for email verification
# EMAIL_API_KEY=""
# EMAIL_FROM="no-reply@ashiskillrise.org"

# Frontend Application URL
APP_URL="http://localhost:3000"
